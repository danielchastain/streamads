# Copy to .env.local and fill in.
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# Twitch app: https://dev.twitch.tv/console/apps
# OAuth redirect URL must be APP_URL/api/auth/callback
# Leave blank in development to use the built-in dev login.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Stripe (test mode keys). Leave blank in development to skip payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set to true to let advertisers book WITHOUT paying (works in production too).
# Remove it (or set to false) and add Stripe keys to start taking real payments.
FREE_TEST_MODE=true

# Airtime checks. When ON, an ad only earns airtime while the streamer is live on Twitch with "Store past
# broadcasts" enabled. Default: ON when FREE_TEST_MODE is off, OFF (record-only) when it's on. Set true/false to force.
# STREAM_CHECKS=true
# REQUIRE_LIVE=true
# REQUIRE_VOD=true

# Hours a finished booking's payout is held before it's sent to the streamer (default 48). Admins can hold or
# release any payout early from /admin.
# PAYOUT_HOLD_HOURS=48

# Your cut of each booking, in percent.
PLATFORM_FEE_PERCENT=15

# Twitch logins allowed into /admin (comma-separated). Leave empty to lock /admin for everyone.
ADMIN_LOGINS=dan7hem4n
